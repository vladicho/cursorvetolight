{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cursorvetolight",
  "main": "./worker/index.ts",
  "workers_dev": true,
  "preview_urls": false,
  "compatibility_date": "2026-08-24",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ADMIN_EMAILS": "vladi.acg@gmail.com",
    "APP_ORIGIN": "https://lugarerrado.com",
    "APP_ORIGINS": "https://lugarerrado.com,https://cursorvetolight.vladi-acg.workers.dev",
    "GOOGLE_CLIENT_ID": "1074979364289-lrn10t4t84eb3p1o2lcs8iiv7hsbjmeh.apps.googleusercontent.com"
  },
  "routes": [
    {
      "pattern": "lugarerrado.com/*",
      "zone_name": "lugarerrado.com"
    },
    {
      "pattern": "www.lugarerrado.com/*",
      "zone_name": "lugarerrado.com"
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cursorvetolight-auth",
      "database_id": "d786371f-8425-4a89-819e-0beca186032d",
      "migrations_dir": "migrations"
    }
  ],
  "ai_search_namespaces": [
    {
      "binding": "AI_SEARCH",
      "namespace": "cursorvetolight"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
